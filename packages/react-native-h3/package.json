{
  "name": "react-native-h3",
  "version": "0.1.0",
  "description": "Fast H3 geospatial indexing for React Native, powered by Nitro Modules",
  "main": "lib/index",
  "module": "lib/index",
  "types": "lib/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "license": "MIT",
  "author": "Viktor Gorte",
  "homepage": "https://github.com/vgorte/react-native-h3#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vgorte/react-native-h3.git"
  },
  "bugs": {
    "url": "https://github.com/vgorte/react-native-h3/issues"
  },
  "keywords": [
    "react-native",
    "nitro-modules",
    "h3",
    "geospatial",
    "hexagon",
    "ios",
    "android"
  ],
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "build": "tsc",
    "specs": "nitrogen",
    "test": "bun test",
    "parity": "bun test parity",
    "prepack": "bun run ../../scripts/check-pack.ts",
    "release": "release-it"
  },
  "files": [
    "src",
    "lib",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "cpp/*.hpp",
    "cpp/*.cpp",
    "cpp/core",
    "cpp/ops",
    "cpp/shapes",
    "third_party/h3/include/**/*.h",
    "third_party/h3/lib/**/*.c",
    "third_party/h3/LICENSE",
    "third_party/h3/NOTICE",
    "third_party/h3/H3_VERSION",
    "third_party/h3/sources.json",
    "android/build.gradle",
    "android/gradle.properties",
    "android/CMakeLists.txt",
    "android/src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "release-it": {
    "npm": {
      "publish": true
    },
    "git": false,
    "github": {
      "release": false
    }
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "^0.37.0"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "h3-js": "4.5.0",
    "nitrogen": "0.37.0",
    "react": "19.2.3",
    "react-native": "0.87.0",
    "react-native-nitro-modules": "0.37.0",
    "typescript": "^5.6.0"
  }
}
