{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    // the base config pulls in Jest's globals; the harness suite imports `expect` and `test`.
    "types": [],
    "baseUrl": ".",
    // typecheck against the package sources, lib/ is build output and absent on CI
    "paths": {
      "react-native-nitro-h3": ["../../packages/react-native-nitro-h3/src/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
