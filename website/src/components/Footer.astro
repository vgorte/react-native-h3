---
import { Icon } from '@astrojs/starlight/components'
import Default from '@astrojs/starlight/components/Footer.astro'
import { REPO } from '../../pages'
---

<Default {...Astro.props}><slot /></Default>
<nav class="site-footer" aria-label="Project links">
  <a href="https://www.npmjs.com/package/react-native-nitro-h3"><Icon name="npm" /> npm</a>
  <a href={REPO}><Icon name="github" /> GitHub</a>
  <a href={`${REPO}/blob/main/LICENSE`}>MIT license</a>
  <span>Built by Viktor Gorte</span>
</nav>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .site-footer a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: inherit;
    text-decoration: none;
  }

  .site-footer a:hover {
    text-decoration: underline;
  }
</style>
